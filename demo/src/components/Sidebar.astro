---
import { ThemeToggle } from "../islands/ThemeToggle.tsx";

const NAV = [
	{
		section: "Docs",
		items: [
			{ to: "/", label: "Overview", icon: "ph-rows" },
			{
				to: "/getting-started",
				label: "Getting started",
				icon: "ph-rocket-launch",
			},
			{ to: "/api", label: "API reference", icon: "ph-terminal-window" },
		],
	},
	{
		section: "Examples",
		items: [
			{ to: "/modes", label: "Replace vs Stack", icon: "ph-squares-four" },
			{ to: "/imperative", label: "Imperative API", icon: "ph-lightning" },
			{ to: "/scopes", label: "Scopes", icon: "ph-stack" },
			{ to: "/portals", label: "Portals", icon: "ph-arrow-square-out" },
			{ to: "/playground", label: "Playground", icon: "ph-sliders-horizontal" },
		],
	},
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<aside class="sidebar">
	<div class="sidebar__brand">
		<span class="sidebar__logo" aria-hidden="true"><i class="ph ph-rows"></i></span>
		<span class="sidebar__title">
			<strong>react-status-bar</strong>
			<small>interactive demo</small>
		</span>
	</div>

	<nav class="nav">
		{
			NAV.map((group) => (
				<div class="nav__group">
					<span class="nav__heading">{group.section}</span>
					{group.items.map((item) => (
						<a
							href={item.to}
							class:list={["nav__link", { "nav__link--active": path === item.to }]}
						>
							<i class={`ph ${item.icon}`} aria-hidden="true"></i>
							{item.label}
						</a>
					))}
				</div>
			))
		}
	</nav>

	<div class="sidebar__foot">
		<ThemeToggle client:load />
		<a
			class="sidebar__gh"
			href="https://github.com/mrmartineau/react-status-bar"
			aria-label="GitHub repository"
		>
			<i class="ph ph-github-logo" aria-hidden="true"></i>
		</a>
	</div>
</aside>
