---
import { DocsLayout } from "@mrmartineau/zui-theme/astro";
import "@phosphor-icons/web/regular";
import "../styles/global.css";
import { GlobalStatusBar } from "../islands/GlobalStatusBar.tsx";
import { sections, site } from "../site.config";

interface Props {
	title?: string;
	description?: string;
}
const { title, description } = Astro.props;
---

<DocsLayout
	title={title}
	description={description}
	currentPath={Astro.url.pathname}
	site={site}
	sections={sections}
>
	<slot />

	{/* Fixed global bar node — always in the DOM so its aria-live region is
	    stable. The GlobalStatusBar island portals its viewport in here. */}
	<Fragment slot="body-end">
		<div id="statusbar-global" class="statusbar-shell"></div>
		<GlobalStatusBar client:load />
	</Fragment>
</DocsLayout>
