---
import "@mrmartineau/zui/css";
import "@phosphor-icons/web/regular";
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import { GlobalStatusBar } from "../islands/GlobalStatusBar.tsx";

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="react-status-bar — a portal-based status bar system for React" />
		<title>{title}</title>
	</head>
	<body>
		<div class="app">
			<Sidebar />
			<main class="main">
				<slot />
			</main>
		</div>

		{/* Fixed global bar node — always in the DOM so its aria-live region is
		    stable. The GlobalStatusBar island portals its viewport in here. */}
		<div id="statusbar-global" class="statusbar-shell"></div>
		<GlobalStatusBar client:load />
	</body>
</html>
