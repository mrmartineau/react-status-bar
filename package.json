{
	"name": "@mrmartineau/react-status-bar",
	"version": "0.0.0",
	"description": "Lightweight, portal-based status bar system for React. Any component can push UI into a shared bar; the viewport owns presentation.",
	"license": "ISC",
	"type": "module",
	"keywords": [
		"react",
		"status-bar",
		"statusbar",
		"portal",
		"useSyncExternalStore",
		"aria-live"
	],
	"files": [
		"dist"
	],
	"author": {
		"name": "Zander Martineau",
		"email": "zander@zander.wtf",
		"url": "https://zander.wtf"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mrmartineau/react-status-bar.git"
	},
	"homepage": "https://github.com/mrmartineau/react-status-bar",
	"bugs": {
		"url": "https://github.com/mrmartineau/react-status-bar/issues"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"build": "tsdown src/index.tsx --format cjs,esm --target es2020 --dts --sourcemap --clean",
		"check": "biome check --write .",
		"dev": "tsdown src/index.tsx --format cjs,esm --target es2020 --dts --sourcemap --watch",
		"demo": "bun run --cwd demo dev",
		"release": "semantic-release",
		"test": "bun test"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@happy-dom/global-registrator": "^16.5.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.1.0",
		"@types/bun": "^1.3.10",
		"@types/node": "^25.4.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"semantic-release": "^25.0.3",
		"tsdown": "^0.21.2",
		"typescript": "^5.9.3"
	}
}
